# El emulador de AWS genera sus propias credenciales temporales en
# ~/.aws/emulator/9297/; scripts/deploy-aws-emulator.sh las usa solas.
# No hace falta definir variables AWS y nunca deben ponerse claves reales aquí.
# Opcionales (valores por defecto entre paréntesis):
# EMULATOR_PORT=9297
# EMULATOR_DIR=$HOME/.aws/emulator/9297
# BUCKET=logitrack-web
# DIST_DIR=./dist
